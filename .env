# Backend configuration — XAMPP MySQL defaults.
# These match a stock XAMPP install (user "root", no password). Change DB_PASSWORD
# if you set a MySQL root password in XAMPP.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=scraper_db

# Allowed CORS origins (comma-separated). "*" is fine for local dev.
CORS_ORIGINS=*

# Secret used to sign login tokens (JWT). Keep this private.
SECRET_KEY=3m7Zt6Rjiy67wlsLEzuwR_ON9ySOzApAwfXV4AGnZkI
